# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
#
# ghb_chanter is Rust (repro-svg builds the crate first) and names its own
# sheet, so it writes into $OUT's directory and the tool compares the file it
# asked for. The crate builds on practice-chanters and, through it,
# square-flute, four-hole-ocarinas and swept-curve, and on bore-tmm and
# lasermade-tools, all checked out beside this one.

cut-files/ghb-chanter-4-sided-sheet1-cut-files.svg :: target/release/ghb_chanter --out=$(dirname $OUT)
cut-files/ghb-chanter-6-sided-sheet1-cut-files.svg :: target/release/ghb_chanter --sides=6 --out=$(dirname $OUT)
cut-files/ghb-chanter-8-sided-sheet1-cut-files.svg :: target/release/ghb_chanter --sides=8 --out=$(dirname $OUT)
previews/ghb-chanter-4-sided-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/ghb-chanter-4-sided-sheet1-cut-files.svg $OUT
previews/ghb-chanter-6-sided-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/ghb-chanter-6-sided-sheet1-cut-files.svg $OUT
previews/ghb-chanter-8-sided-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/ghb-chanter-8-sided-sheet1-cut-files.svg $OUT
turn.html :: target/release/ghb_chanter --page-to=$OUT
index.html :: ../lasermade-tools/target/release/md2html README.md $OUT

# --- the STEP files: the 3D view's parts as solids for a CAD program, one
# file per design, written from the page by lasermade-tools' step-export ---
step/ghb-chanter-4-sides.step :: ../lasermade-tools/target/release/step-export turn.html --name=ghb-chanter --out=$(dirname $OUT)
step/ghb-chanter-6-sides.step :: ../lasermade-tools/target/release/step-export turn.html --name=ghb-chanter --out=$(dirname $OUT)
step/ghb-chanter-8-sides.step :: ../lasermade-tools/target/release/step-export turn.html --name=ghb-chanter --out=$(dirname $OUT)
