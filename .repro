# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
#
# ghb_chanter is Rust (repro-svg builds the crate first) and names its own
# sheet, so it writes into $OUT's directory and the tool compares the file it
# asked for. The crate builds on practice-chanters and, through it,
# square-flute, four-hole-ocarinas and swept-curve, and on bore-tmm and
# lasermade-tools, all checked out beside this one.

cut-files/ghb-chanter-4-sided-sheet1-cut-files.svg :: target/release/ghb_chanter --out=$(dirname $OUT)
cut-files/ghb-chanter-6-sided-sheet1-cut-files.svg :: target/release/ghb_chanter --sides=6 --out=$(dirname $OUT)
cut-files/ghb-chanter-8-sided-sheet1-cut-files.svg :: target/release/ghb_chanter --sides=8 --out=$(dirname $OUT)
previews/ghb-chanter-4-sided-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/ghb-chanter-4-sided-sheet1-cut-files.svg $OUT
previews/ghb-chanter-6-sided-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/ghb-chanter-6-sided-sheet1-cut-files.svg $OUT
previews/ghb-chanter-8-sided-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/ghb-chanter-8-sided-sheet1-cut-files.svg $OUT
turn.html :: target/release/ghb_chanter --page-to=$OUT
index.html :: ../lasermade-tools/target/release/md2html README.md $OUT

# --- the SolidCraft designs: each script, its design (slimmed by sc-slim so it
# is the same every run), and the STEP file SolidCraft builds from it ---
solidcraft/ghb-chanter-4-sides.solidcraft.json :: target/release/ghb_chanter --solidcraft=$(dirname $OUT)
solidcraft/ghb-chanter-4-sides.sc :: target/release/ghb_chanter --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/ghb-chanter-4-sides.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
step/ghb-chanter-4-sides.step :: target/release/ghb_chanter --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/ghb-chanter-4-sides.solidcraft.json --out $OUT --quiet
solidcraft/ghb-chanter-6-sides.solidcraft.json :: target/release/ghb_chanter --solidcraft=$(dirname $OUT)
solidcraft/ghb-chanter-6-sides.sc :: target/release/ghb_chanter --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/ghb-chanter-6-sides.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
step/ghb-chanter-6-sides.step :: target/release/ghb_chanter --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/ghb-chanter-6-sides.solidcraft.json --out $OUT --quiet
solidcraft/ghb-chanter-8-sides.solidcraft.json :: target/release/ghb_chanter --solidcraft=$(dirname $OUT)
solidcraft/ghb-chanter-8-sides.sc :: target/release/ghb_chanter --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/ghb-chanter-8-sides.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
step/ghb-chanter-8-sides.step :: target/release/ghb_chanter --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/ghb-chanter-8-sides.solidcraft.json --out $OUT --quiet
